---
import { type Post, isoDay, readingMinutes, shortDate, topicColor } from '../lib/posts';

interface Props {
	posts: Post[];
	/** Cap tieu de cua ten bai, tuy trang dang dat danh sach duoi h2 hay h3. */
	heading?: 'h2' | 'h3';
}

const { posts, heading: Heading = 'h3' } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">Chưa có bài nào ở đây.</p>
	) : (
		<ul class="posts">
			{posts.map((post) => {
				const date = shortDate(post.data.pubDate);
				return (
					<li class="post">
						<a href={`/blog/${post.id}/`}>
							<time datetime={isoDay(post.data.pubDate)}>
								<b>{date.day}</b>
								{date.rest}
							</time>
							<div>
								{post.data.topic && (
									<span class={`tag ${topicColor(post.data.topic)}`}>{post.data.topic}</span>
								)}
								<Heading>{post.data.title}</Heading>
								<p>{post.data.description}</p>
								<span class="mins">{readingMinutes(post)} phút đọc</span>
							</div>
						</a>
					</li>
				);
			})}
		</ul>
	)
}
