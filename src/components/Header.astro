---
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/', label: 'Trang chủ' },
	{ href: '/blog/', label: 'Bài viết' },
	{ href: '/chu-de/', label: 'Chủ đề' },
	{ href: '/about/', label: 'Giới thiệu' },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}, về trang chủ`}>
			<span class="brand-mark" aria-hidden="true">{SITE_TITLE.charAt(0)}</span>
			{SITE_TITLE}
		</a>
		<nav class="nav" aria-label="Điều hướng chính">
			{
				links.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>
		<button
			class="theme-toggle"
			id="theme-toggle"
			type="button"
			aria-label="Chuyển giao diện sáng hoặc tối"
		>
			<svg
				class="icon-moon"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg
			>
			<svg
				class="icon-sun"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				><circle cx="12" cy="12" r="4"></circle><path
					d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
				></path></svg
			>
		</button>
	</div>
</header>
