---
// global.css duoc nap o day nen moi trang dung <BaseHead /> deu co giao dien chung.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website' } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />

<!--
	Dat giao dien TRUOC khi trang ve, de khong bi nhay sang roi moi chuyen toi.
	Thu tu uu tien: ?theme=light|dark (xem thu) > nguoi xem vua bam nut > gio tren may nguoi xem.
-->
<script is:inline>
	(function () {
		var KEY = 'tt-theme-override';
		var theme = null;
		var q = /[?&]theme=(light|dark)/.exec(location.search);
		if (q) theme = q[1];
		if (!theme) {
			try {
				var o = JSON.parse(localStorage.getItem(KEY));
				if (o && o.until > Date.now() && (o.theme === 'light' || o.theme === 'dark')) theme = o.theme;
			} catch (e) {}
		}
		if (!theme) {
			var h = new Date().getHours(); /* gio theo mui gio cua nguoi dang xem */
			theme = h >= 6 && h < 18 ? 'light' : 'dark';
		}
		document.documentElement.setAttribute('data-theme', theme);
	})();
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Be Vietnam Pro, nhung thang vao trang (Astro tai ve luc build), co bo chu tieng Viet. -->
<Font cssVariable="--font-be-vietnam" />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="vi_VN" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={new URL(image.src, Astro.site)} />}
